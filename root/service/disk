let disks = 2;
let fd;
const use_tmpfs = true;
function link_filesystem(name, fs) {
  if (fs.magic !== 20) {
    fprintf(`Cannot link filesystem ${name}: invalid magic header`);
    return;
  }
  initiate_fs(fs, name);
  fd = fopen("/dev/" + name, "w");
  printf("Created /dev/" + name + "\n");
  write(fd, fs);
  fclose(fd);
}
