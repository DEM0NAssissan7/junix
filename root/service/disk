async function sync_disks() {
  sync(); // Sync disks every 30 seconds
  await sleep(1000 * 30);
}
function initiate_fs(fs, disk_id) {
  fs.sync = function () {
    localStorage.setItem(disk_id, fs.stringify());
    console.log("Synced disk");
  };
}
function create_disk() {
  let fs = new JFS();
  const id = "ls" + disks;
  printf("Creating /dev/" + id + "\n");
  initiate_fs(fs, id);
  localStorage.setItem(id, fs.stringify());
  let _fd = fopen("/dev/" + id, "w");
  write(_fd, fs);
  fclose(_fd);
  printf("Created /dev/" + id + "\n");
  disks++;
}
let input;
function call_watcher() {
  input = read(fd);
  if (input.length > 0) {
    if (input == "c") {
      create_disk();
    }
  }
  write(fd, "");
}
