let completed = false;
let quiet = false;
let write_etc = false;
let reboot_when_finshed = false;

this.main = async function (args) {
  for (let arg of args) {
    switch (arg) {
      case "-q":
      case "--quiet":
        quiet = true;
        continue;
      case "-e":
      case "--write-etc":
        write_etc = true;
        continue;
      case "-r":
      case "--reboot":
        reboot_when_finshed = true;
        continue;
    }
    break;
  }
  if (quiet) {
    fclose(stdout, true);
    fopen("/dev/null", "w");
  }
  printf("Running JUNIX system update...\n\n");

  // Mount the virtual update partitions
  printf("Mounting update filesystems\n");
  mkdir("/mnt/update");
  mount("/dev/jrfs1", "/mnt/update");
  mount("/dev/jrfs0", "/mnt/update/boot");

  // Copy files
  printf("Copying update files to the rest of the system\n");
  if (!write_etc) {
    await copy_dirs(
      "/mnt/update",
      "/bin",
      "/boot",
      "/sbin",
      "/service",
      "/usr",
    );
    await copy_files("/mnt/update", "/etc/os-release");
    await copy_files("/mnt/update", "/boot/kernel");
  } else await copy_dirs("/"); // Copy all directories from update file
  completed = true;

  printf("\nFiles successfully copied!\n");
  printf("Unmounting update filesystems...\n");
  umount("/mnt/update/boot");
  umount("/mnt/update");
  printf("Cleaning update directory");
  rmdir("/mnt/update");
  printf("Syncing update changes...\n");
  sync();
  printf("\n\nUpdate complete!\n");
  if (!reboot_when_finshed) exit();
  else {
    printf("Rebooting after update finished...\n");
    reboot(3);
  }
  return 0;
};
async function copy_dirs(source, ...names) {
  for (let name of names) {
    const dir = name;
    printf(source + dir + " -> " + dir + "\n");
    fork(() => {
      exec(source + "/bin/cp", ["-r", source + dir, dir]);
    });
    await wait();
  }
}
async function copy_files(source, ...names) {
  for (let name of names) {
    const path = name;
    printf(source + path + " -> " + path + "\n");
    fork(() => {
      exec(source + "/bin/cp", [source + path, path]);
    });
    await wait();
  }
}
